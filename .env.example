PORT=3000
RATE_LIMIT_MAX_PER_MINUTE=10   # mensajes permitidos por numero antes de pedirle que espere
RATE_LIMIT_WINDOW_SECONDS=120  # cuanto dura la espera (en segundos) antes de poder volver a escribir

WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_AUTH_DIR=.whatsapp-web-auth   # carpeta donde se guarda la sesion vinculada (no commitear)
WHATSAPP_WEB_TEAM_GROUP_JID=               # JID del grupo de WhatsApp del equipo (se lista en consola al conectar); vacio = no avisa
WHATSAPP_WEB_TECHNICIANS=Ricardo Hernandez:42584634,Toño:30911545   # nombre:numero de WhatsApp, separado por comas — cada ticket nuevo le toca a uno distinto por turno (round-robin); vacio = no reparte

GLPI_API_URL=          # ej: https://glpi.tuempresa.com/apirest.php
GLPI_APP_TOKEN=        # Configuracion > General > API > "App Token" (crear uno)
GLPI_USER_TOKEN=       # Perfil del usuario tecnico > "Tokens de acceso remoto" > Token API
GLPI_ENTITY_ID=0       # ID de la entidad/empresa en GLPI (0 = raiz, preguntar si hay varias)
GLPI_CAT_ST1=          # ID de categoria "Atencion remota" en GLPI (Configuracion > Categorias ITIL)
GLPI_CAT_ST2=          # ID de categoria "En sitio"
GLPI_CAT_ST3=          # ID de categoria "Reparacion de equipo de taller"

GLPI_LOCATIONS=

# Verificacion de identidad contra el portal de reclutamiento interno — deja
# VERIFICATION_ENABLED en false (o sin definir) para que el bot funcione como
# siempre, sin pedirle nada a nadie.
VERIFICATION_ENABLED=false
VERIFIED_NUMBERS_FILE=.verified-numbers.json   # archivo donde se guardan los numeros ya verificados (no commitear)

# Portal de reclutamiento interno contra el que se valida usuario/contrasena.
# Vacio = modo mock (cualquier credencial se acepta, para poder probar el
# flujo completo sin pegarle al sistema real).
RECLUTAMIENTO_API_URL=          # ej: https://reclutamiento.conred.gob.gt
GLPI_V2_URL=          # ej: http://tu-servidor:4700/api/glpi/v2.3/Administration/Entity
GLPI_V2_API_KEY=      # no la commitees con un valor real
